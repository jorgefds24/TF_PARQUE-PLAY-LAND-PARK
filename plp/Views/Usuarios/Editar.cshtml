@model plp.Shared.Models.Usuarios

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Editar Empleado</h2>
        <form asp-action="Editar" asp-controller="Usuarios">
            <input asp-for= "IdUsuario" type="hidden" />
            <div class="mb-3">
                <label>Nombre</label>
                <input class="form-control" asp-for="Nombre" type="text" />
            </div>

            <div class="mb-3">
                <label>Apellido</label>
                <input class="form-control" asp-for="Apellido" type="text" />
            </div>

            <div class="mb-3">
                <label>Correo</label>
                <input class="form-control" asp-for="Correo" type="text" />
            </div>

            <div class="mb-3">
                <label>Clave</label>
                <input class="form-control" asp-for="Clave" type="password" readonly />
            </div>

            <div class="mb-3">
                <label>Rol</label>
                <select asp-for="IdRol" asp-items="ViewBag.Roles" class="form-control"></select>
                <!-- Aquí necesitarás cargar tus roles desde la base de datos -->
                <!-- <option value="1">Admin</option>
                <option value="2">Usuario</option> -->
                </select>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-controller="Usuarios" asp-action="Lista" class="btn btn-warning">Volver</a>
            </div>
        </form>
    </div>
</div>
