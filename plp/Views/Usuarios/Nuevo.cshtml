<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->


</head>

<body>

@model plp.Shared.Models.Usuarios

    @{
        ViewData["Title"] = "Agregar Usuario";
    }

    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">AGREGAR USUARIO</h6>
        </div>
    </div>

        <form asp-action="Nuevo" asp-controller="Usuarios" id="nuevoUsuarioForm" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-row mb-3 mt-4 d-flex">
                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Nombre" class="form-label"><strong>Nombre</strong></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Apellido" class="form-label"><strong>Apellido</strong></label>
                    <input asp-for="Apellido" class="form-control" placeholder="Apellido" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row mb-3 mt-4 d-flex">
                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Correo" class="form-label"><strong>Correo</strong></label>
                    <input asp-for="Correo" class="form-control" type="email" placeholder="Correo" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="IdRol" class="form-label"><strong>Rol</strong></label>
                    <select asp-for="IdRol" asp-items="ViewBag.Roles" class="form-control">
                        <option value="" >Selecciona un rol</option>
                    </select>
                    <span asp-validation-for="IdRol" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row d-flex">
                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Clave" class="form-label"><strong>Clave</strong></label>
                    <input asp-for="Clave" class="form-control" type="password" id="Clave" placeholder="Clave" />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 d-flex flex-column">
                    <label class="form-label"><strong>Repetir Clave</strong></label>
                    <input class="form-control" type="password" id="RepetirClave" placeholder="Repetir Clave" />
                    <span id="repetirClaveError" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-center mt-4">
                <button type="submit" class="btn btn-primary mx-2">
                    <i class="fas fa-save"></i> Guardar
                </button>
                <a asp-controller="Usuarios" asp-action="Lista" class="btn btn-danger mx-2">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>




    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#nuevoUsuarioForm').submit(function (event) {
                var clave = $('#Clave').val();
                var repetirClave = $('#RepetirClave').val();

                if (clave !== repetirClave) {
                    alert("Las contraseñas no coinciden");
                    event.preventDefault();
                }
            });
        });
    </script>

    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
</body>

</html>
