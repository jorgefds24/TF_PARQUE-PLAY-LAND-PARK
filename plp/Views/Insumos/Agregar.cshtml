<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->

</head>

<body>

    @model plp.ViewModels.InsumoViewModel

    @{
        ViewData["Title"] = "Agregar Insumo";
    }

    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">AGREGAR INSUMOS</h6>
        </div>
    </div>

    <!-- Cambiado a container-fluid para ocupar todo el ancho -->
    <form asp-controller="Insumos" asp-action="Agregar" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group ">
            <label asp-for="Titulo" class="control-label"><strong>Título</strong></label>
            <input asp-for="Titulo" class="form-control" type="text" placeholder="Ingrese el título del insumo" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>

        <div class="form-row d-flex">
            <div class="form-group col-md-6 mt-4 d-flex flex-column">
                <label asp-for="TipoInsumo" class="control-label"><strong>Tipo de Insumo</strong></label>
                <input asp-for="TipoInsumo" class="form-control" placeholder="Ingrese el tipo de insumo" />
                <span asp-validation-for="TipoInsumo" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6 mt-4 d-flex flex-column">
                <label asp-for="Monto" class="control-label"><strong>Monto</strong></label>
                <input asp-for="Monto" class="form-control" placeholder="Ingrese el monto" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 mt-4">
            <label asp-for="Foto" class="control-label"><strong>Foto</strong></label>
            <input asp-for="Foto" type="file" class="form-control" />
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-center mt-4">
            <button type="submit" class="btn btn-primary mx-2">
                <i class="fas fa-save"></i> Guardar
            </button>
            <a asp-controller="Insumos" asp-action="Index" class="btn btn-danger mx-2">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

</body>

</html>
