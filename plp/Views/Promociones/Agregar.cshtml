<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->
</head>

<body>

    @model plp.ViewModels.PromocionViewModel

    @{
        ViewData["Title"] = "Agregar Promoción";
    }

    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">AGREGAR PROMOCIONES</h6>
        </div>
    </div>

    <form asp-controller="Promociones" asp-action="Agregar" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-row d-flex">
            <div class="form-group col-md-6 d-flex flex-column">
                <label asp-for="Titulo" class="form-label"><strong>Título</strong></label>
                <input asp-for="Titulo" class="form-control" placeholder="Título de la promoción" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6 d-flex flex-column">
                <label asp-for="Descuento" class="form-label"><strong>Descuento</strong></label>
                <input asp-for="Descuento" class="form-control" placeholder="Descuento" />
                <span asp-validation-for="Descuento" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row d-flex">
            <div class="form-group col-md-6 mt-4 d-flex flex-column">
                <label asp-for="FechaInicio" class="form-label"><strong>Fecha de Inicio</strong></label>
                <input asp-for="FechaInicio" class="form-control" placeholder="Fecha de inicio" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6 mt-4 d-flex flex-column">
                <label asp-for="FechaFin" class="form-label"><strong>Fecha de Fin</strong></label>
                <input asp-for="FechaFin" class="form-control" placeholder="Fecha de fin" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 mt-4">
            <label asp-for="Foto" class="form-label"><strong>Subir imagen</strong></label>
            <input asp-for="Foto" type="file" class="form-control" />
            <span asp-validation-for="Foto" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-center">
            <button class="btn btn-primary mx-2" type="submit">
                <i class="fas fa-save"></i> Guardar
            </button>
            <a asp-controller="Promociones" asp-action="Index" class="btn btn-danger mx-2">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>

    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }

    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

</body>

</html>
