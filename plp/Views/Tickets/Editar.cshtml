<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->
</head>

<body>

    @model plp.ViewModels.TicketViewModel

    @{
        ViewData["Title"] = "Editar Ticket";
    }

    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">EDITAR TICKET</h6>
        </div>
    </div>

    <form asp-controller="Tickets" asp-action="Editar" method="post">
        <input type="hidden" asp-for="IdTicket" />

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Nombre" class="form-label"><strong>Nombre</strong></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label asp-for="Precio" class="form-label"><strong>Precio</strong></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group col-md-6">
                <label for="Color" class="form-label"><strong>Color</strong></label>
                <select id="Color" name="Color" class="form-control">
                    <option value="#FF8F77">Salmón</option>
                    <option value="#A48479">Cafe</option>
                    <option value="#FFF55C">Amarillo</option>
                    <option value="#E784F4">Morado</option>
                    <option value="#FFFFFF">Blanco</option>
                    <option value="#A0DAFF">Celeste</option>
                    <option value="#59B489">Verde</option>
                    <option value="#F895B5">Rosado</option>
                    <option value="#B8B8B8">Gris</option>
                    <option value="#000000">Negro</option>
                </select>
            </div>
        </div>

        <div class="d-flex mt-4 justify-content-center">
            <button type="submit" class="btn btn-primary mx-2">
                <i class="fas fa-save"></i> Guardar
            </button>
            <a asp-action="Index" class="btn btn-danger mx-2">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>


    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

</body>

</html>

