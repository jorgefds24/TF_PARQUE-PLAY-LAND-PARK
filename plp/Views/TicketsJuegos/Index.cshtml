<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/stylesticketsjuegos.css"> <!-- Verifica la ruta correcta -->
</head>

<body>

    <!-- DataTables Example -->
    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">GESTIÓN DE TICKETS</h6>
        </div>
    </div>

    @model IEnumerable<plp.Shared.Models.Tickets>

    <a href="@Url.Action("Agregar")" class="btn btn-success mb-4 btn-registro">
        <i class="fas fa-plus-circle"></i> <span class="font-weight-normal">Nuevo Registro</span>
    </a>


    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var ticket in Model)
        {
            <div class="col">
                <div class="card h-100" style="background-color: @ticket.Color">
                    @* <img src="ruta_de_tu_imagen.jpg" class="card-img-top" alt="Descripción de la imagen"> *@
                    <div class="card-body">
                        <h5 class="card-title">@ticket.Nombre</h5>
                        <a href="@Url.Action("Detalles", new { idTicket = ticket.IdTicket })" class="btn btn-primary">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>



    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>

</body>
</html>
