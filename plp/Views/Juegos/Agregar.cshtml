<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Incluye el CSS de DataTables -->
    <link rel="stylesheet" type="text/css" href="//cdn.datatables.net/2.0.8/css/dataTables.dataTables.min.css">
    <!-- Incluye el CSS de FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS personalizado -->
    <link rel="stylesheet" href="~/css/stylestablas.css"> <!-- Verifica la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css"> <!-- Verifica la ruta correcta -->

</head>

<body>

    @model plp.ViewModels.JuegoViewModel

    @{
        ViewData["Title"] = "Agregar Juego";
    }

    <div class="custom-header-container">
        <div class="custom-header text-center mb-4">
            <h6 class="m-0 juegos-header">AGREGAR JUEGOS</h6>
        </div>
    </div>

        <form asp-controller="Juegos" asp-action="Agregar" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-row d-flex">
                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Nombre" class="form-label"><strong>Nombre del juego</strong></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Nombre del juego" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6 d-flex flex-column">
                    <label asp-for="Capacidad" class="form-label"><strong>Capacidad del juego</strong></label>
                    <input asp-for="Capacidad" class="form-control" placeholder="Capacidad del juego" />
                    <span asp-validation-for="Capacidad" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3 mt-4">
                <label class="form-label"><strong>Estado del Juego</strong></label>
                <div class="btn-group d-flex mb-2" role="group">
                    <button type="button" class="btn btn-success w-100" onclick="document.getElementById('Estado').value='Disponible'">
                        <i class="fas fa-check"></i> Disponible
                    </button>
                    <button type="button" class="btn btn-danger w-100" onclick="document.getElementById('Estado').value='NoDisponible'">
                        <i class="fas fa-times"></i> No Disponible
                    </button>
                </div>
                <input id="Estado" asp-for="Estado" class="form-control" readonly />
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
            <label asp-for="Foto" class="form-label"><strong>Subir imagen</strong></label>
                <input asp-for="Foto" type="file" class="form-control" />
                <span asp-validation-for="Foto" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button class="btn btn-primary mx-2" type="submit">
                    <i class="fas fa-save"></i> Guardar
                </button>
            <a asp-controller="Juegos" asp-action="Index" class="btn btn-danger mx-2">
                <i class="fas fa-times"></i> Cancelar
            </a>
            </div>
        </form>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }

    <!-- Asegúrate de tener referenciado jQuery y Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" crossorigin="anonymous"></script>
    <!-- Incluye el JS de DataTables -->
    <script type="text/javascript" src="//cdn.datatables.net/2.0.8/js/dataTables.min.js"></script>
</body>

</html>
