@model IEnumerable<plp.Shared.Models.Insumos>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Insumos - Play Land Park</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="~/assets/favicon.ico" />
    <!-- Font Awesome icons (free version) -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap) -->
    @*     <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" /> *@
    @*     <link href="~/css/styles.css" rel="stylesheet" /> *@
    <link href="~/css/styleslogin.css" rel="stylesheet" />
    <link rel="stylesheet" media="all" href="~/css/stylesclases.css" />
    <link rel="stylesheet" media="all" href="~/css/styleslogin.css" />

</head>
<body id="page-top">
    <div class="top-image-container">
        <img class="background" src="/imagenes/insumos.jpg" />
    </div>

    <div class="container mt-5">
        <h2 class="text-center text-primary">INSUMOS</h2>
        <div class="container-insumos d-flex flex-wrap justify-content-center">
            @foreach (var tipo in Model.Select(i => i.TipoInsumo).Distinct())
            {
                <div class="card rounded-circle m-3 tipo-insumo" data-tipo="@tipo" style="width: 200px; height: 200px; overflow: hidden;">
                    <div class="card-img-overlay d-flex flex-column justify-content-center align-items-center text-white">
                        <h5 class="card-title text-center">@tipo</h5>
                        <a href="#" class="btn btn-primary mt-2 ver-mas" data-bs-toggle="modal" data-bs-target="#insumosModal">Ver más</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Modal de insumos -->
    <div class="modal fade" id="insumosModal" tabindex="-1" aria-labelledby="insumosModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="insumosModalLabel">Insumos por tipo: <span id="tipoInsumoSeleccionado"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row row-cols-1 row-cols-md-3 g-4" id="insumosContainer">
                        @foreach (var item in Model)
                        {
                            <div class="col">
                                <div class="card mb-3 shadow-sm">
                                    <img src="/contenidos/insumos/@item.Imagen" class="card-img-top" style="height: 200px; object-fit: cover;" />
                                    <div class="card-body">
                                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Titulo)</h5>
                                        <h6 class="card-subtitle mb-2 text-muted">@Html.DisplayFor(modelItem => item.Monto)</h6>
                                        <p class="card-text text-muted">@Html.DisplayFor(modelItem => item.TipoInsumo)</p>
                                        <!-- No es necesario el botón Ver más dentro de cada card -->
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.ver-mas').on('click', function () {
                var tipoInsumo = $(this).closest('.tipo-insumo').data('tipo');
                $('#tipoInsumoSeleccionado').text(tipoInsumo);

                // Filtrar insumos por tipo y mostrar en el modal
                $('#insumosContainer .col').hide();
                $('#insumosContainer .col').filter(function () {
                    return $(this).find('.card-text').text().includes(tipoInsumo);
                }).show();
            });
        });
    </script>

    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
</body>
</html>
