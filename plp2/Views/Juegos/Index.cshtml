@model IEnumerable<plp.Shared.Models.Juegos>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Juegos - Play Land Park</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="~/assets/favicon.ico" />
    <!-- Font Awesome icons (free version) -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap) -->
    @*     <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" /> *@
    @*     <link href="~/css/styles.css" rel="stylesheet" /> *@
    <link href="~/css/styleslogin.css" rel="stylesheet" />
    <link rel="stylesheet" media="all" href="~/css/stylesclases.css" />
    <link rel="stylesheet" media="all" href="~/css/stylesjuegos.css" />
    <link rel="stylesheet" media="all" href="~/css/styleslogin.css" />
</head>

<body id="page-top">

    <div class="top-image-container">
        <img class="background" src="/imagenes/juegos.jpg" />
    </div>

    <div class="container mt-5">
        <h2 class="text-center text-primary mb-4">JUEGOS</h2>
        <div class="container-juegos">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm mb-4" style="width: 18rem;">
                    <div class="card-img-overlay">
                        <h5 class="card-title">@Html.DisplayFor(modelItem => item.Nombre)</h5>
                        <h6 class="card-subtitle mb-2">@Html.DisplayFor(modelItem => item.Estado)</h6>
                        <p class="card-text">Capacidad: @Html.DisplayFor(modelItem => item.Capacidad)</p>
                        <a href="#" class="btn btn-primary mt-2">Ver más</a>
                    </div>
                    <img src="/juegos/@item.Imagen" class="card-img-top" style="height: 250px; object-fit: cover;" />
                </div>
            }
        </div>
    </div>


    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
</body>
</html>
