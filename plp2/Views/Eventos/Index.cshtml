@model IEnumerable<plp.Shared.Models.Eventos>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Eventos - Play Land Park</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="~/assets/favicon.ico" />
    <!-- Font Awesome icons (free version) -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <!-- Google fonts -->
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Slab:400,100,300,700" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap) -->

    <link href="~/css/styles.css" rel="stylesheet" />
    <link href="~/css/styleslogin.css" rel="stylesheet" />
    <link rel="stylesheet" media="all" href="~/css/stylesclases.css" />
    <link rel="stylesheet" media="all" href="~/css/styleslogin.css" />
    <link rel="stylesheet" media="all" href="~/css/styleseventos.css" />
</head>
<body id="page-top">

    <div class="top-image-container">
        <img class="background" src="/imagenes/eventos.jpg" />
    </div>

    <div class="container mt-2">
        @* <h2 class="text-center text-primary">¡Descubre nuestras increíbles eventos!</h2> *@
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4">
                    <div class="card mb-4 shadow-sm mt-5">
                        <img src="/contenidos/eventos/@item.Imagen" class="card-img-top" style="height:200px; object-fit:cover;" />
                        <div class="card-body">
                            <h5 class="card-title">@Html.DisplayFor(modelItem => item.Titulo)</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@* 
                                <strong>Fecha:</strong> Del @Html.DisplayFor(modelItem => item.HoraInicio) al @Html.DisplayFor(modelItem => item.HoraFin) *@
                            </h6>
                            <h6 class="card-subtitle mb-2 text-muted mt-5">
                                <strong>Desde </strong> @Html.DisplayFor(modelItem => item.HoraInicio) al @Html.DisplayFor(modelItem => item.HoraFin)
                            </h6>
                            @* <p class="card-text"> @Html.DisplayFor(modelItem => item.FechaEvento)</p> *@
@*                             <a href="#" class="btn btn-primary">Ver más</a> *@
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>



    


    <!-- Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="https://cdn.startbootstrap.com/sb-forms-latest.js"></script>
</body>
</html>
